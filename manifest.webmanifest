{
    "name": "FolioCorpus — Bhagavad-gītā",
    "short_name": "Gītā",
    "description": "Static reading site for the Bhagavad-gītā with translation, purport, ācārya commentaries, and personal guidance.",
    "start_url": "./",
    "scope": "./",
    "display": "standalone",
    "background_color": "#FAF6E8",
    "theme_color": "#6B1D2A",
    "orientation": "any",
    "icons": [
        {
            "src": "assets/icons/icon.svg",
            "sizes": "any",
            "type": "image/svg+xml",
            "purpose": "any"
        },
        {
            "src": "assets/icons/icon-maskable.svg",
            "sizes": "any",
            "type": "image/svg+xml",
            "purpose": "maskable"
        }
    ]
}
